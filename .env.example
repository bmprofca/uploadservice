# Server
PORT=6472
HOST=0.0.0.0
PUBLIC_BASE_URL=https://upload.onesaas.in

# Upload limits
MAX_FILE_SIZE_MB=50

# Files are deleted after this many hours
FILE_TTL_HOURS=24

# Cleanup scan interval (ms)
CLEANUP_INTERVAL_MS=300000

# Comma-separated API keys for the "key" request header
API_KEYS=onedevelopers
